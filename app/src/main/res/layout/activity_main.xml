<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Control de Acceso Automático"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBtConnectionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Sin conexión Bluetooth (Ir a Instrucciones)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHeaderTitle" />

        <!-- Estado del sistema -->
        <LinearLayout
            android:id="@+id/layoutEstado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/card_white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBtConnectionBadge">

            <TextView
                android:id="@+id/tvStateCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTADO DEL SISTEMA:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TextView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="SISTEMA DESACTIVADO"
                android:textColor="@color/state_inactive_red"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Botones de control -->
        <LinearLayout
            android:id="@+id/layoutButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutEstado"
            app:layout_constraintVertical_bias="0.2">

            <Button
                android:id="@+id/Btn1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Instrucciones"
                android:textColor="@color/tech_blue_primary"
                android:textSize="16sp"
                app:strokeColor="@color/tech_blue_primary"
                app:strokeWidth="1.5dp" />

            <Button
                android:id="@+id/Btn2"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/state_active_green"
                android:text="Activar Sistema"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/Btn3"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/tech_blue_primary"
                android:text="Abrir Puerta"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/Btn4"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/tech_blue_dark"
                android:text="Cerrar Puerta"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/Btn5"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/state_inactive_red"
                android:text="Desactivar Sistema"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
